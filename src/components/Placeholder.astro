---
const { note = "photo", ratio = "4 / 3" } = Astro.props;
const id = "ph" + Math.random().toString(36).slice(2, 8);
---
<svg class="ph" viewBox="0 0 400 300" style={`aspect-ratio:${ratio}`} preserveAspectRatio="none" role="img" aria-label={note}>
  <defs>
    <pattern id={id} width="9" height="9" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="0" y2="9" stroke="#dcdee4" stroke-width="3" />
    </pattern>
  </defs>
  <rect width="400" height="300" fill={`url(#${id})`} />
  <text x="200" y="154" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" fill="#767b86">{note}</text>
</svg>
