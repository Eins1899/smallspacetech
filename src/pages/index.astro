---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import Placeholder from "../components/Placeholder.astro";
import Signup from "../components/Signup.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate - a.data.pubDate);
const [featured, ...rest] = posts;
const recent = rest.slice(0, 6);
const fd = featured?.data;
---
<BaseLayout current="home" title="Small Space Tech — honest gear reviews for small rooms"
  description="Desks, storage, power and light we bought with our own money and used in a real small room.">

  <section class="hero">
    <div class="wrap">
      <div class="hero-inner">
        <div class="eyebrow eyebrow--accent">Desks · Storage · Power · Light</div>
        <h1>Gear reviews for people whose office is a corner of the bedroom.</h1>
        <p>Most roundups are written by people who never touched the product. Everything here is something we bought with our own money, put in a small room, and lived with.</p>
      </div>
    </div>
  </section>

  {featured && (
    <section class="wrap" style="padding-top:56px">
      <div class="eyebrow" style="margin-bottom:24px">Latest review</div>
      <a class="featured" href={`/blog/${featured.slug}`}>
        <div class="featured-copy">
          <div class="kicker">
            <span class="cat">{fd.category.toUpperCase()}</span><span>·</span>
            <span>{fd.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</span>
            {fd.readTime && <><span>·</span><span>{fd.readTime}</span></>}
          </div>
          <h2>{fd.title}</h2>
          <p>{fd.description}</p>
          {fd.pricePaid && <div class="chips"><span>{fd.pricePaid}</span></div>}
          <span class="more">Read the comparison →</span>
        </div>
        {fd.heroImage
          ? <img class="ph" src={fd.heroImage} alt={fd.title} />
          : <Placeholder note={fd.heroNote ?? "photo: the product in the room"} />}
      </a>
    </section>
  )}

  {recent.length > 0 && (
    <section class="wrap" style="padding-top:52px">
      <div class="eyebrow" style="margin-bottom:8px">Also on the site</div>
      <div class="rows">
        {recent.map((post) => <PostRow post={post} />)}
      </div>
      <a class="more" href="/reviews" style="display:inline-block;margin-top:26px">All reviews →</a>
    </section>
  )}

  <section class="wrap" style="padding:64px 32px 24px">
    <Signup dark={true} />
  </section>
</BaseLayout>
